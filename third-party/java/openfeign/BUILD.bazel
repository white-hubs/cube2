        ":openfeign_core",
        "@maven//:io_github_openfeign_feign_hystrix",
        "@maven//:io_github_openfeign_feign_slf4j",
        "@maven//:io_github_openfeign_form_feign_form",
        "@maven//:io_github_openfeign_form_feign_form_spring",
    ],
