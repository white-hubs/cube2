load("@rules_jvm_external//:defs.bzl", "java_export", "maven_bom")
load("//packages/platform:variables.bzl", "PACKAGE_GROUP", "PLATFORM_VERSION")

package(default_visibility = ["//packages:__subpackages__"])

artifactId = "platform-bom"

maven_bom(
    name = "bom",
    dependencies_maven_coordinates = ":".join([
        PACKAGE_GROUP,
        artifactId + "-dependencies",
        PLATFORM_VERSION,
    ]),
    java_exports = [
        "//packages/platform/base:export",
        "//packages/platform/cloud:export",
        "//packages/platform/database:export",
        "//packages/platform/job:export",
        "//packages/platform/liquibase:export",
        "//packages/platform/redis:export",
        "//packages/platform/rocketmq:export",
        "//packages/platform/security:export",
        "//packages/platform/web:export",
        "//packages/platform/web-extra:export",
        "//packages/platform/subsystem-config:export",
        "//packages/platform/subsystem-requester-sdk:export",
    ],
    maven_coordinates = ":".join([
        PACKAGE_GROUP,
        artifactId,
        PLATFORM_VERSION,
    ]),
)
