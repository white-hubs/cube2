### 应用/DIFF租户配置差异-non-partial-Simple
POST http://{{baseurl}}/dcm/config/apply?tenant=41850024&types=RoleMenu
Content-Type: application/yaml
Accept: application/yaml;charset=utf-8

schemaVersion: "1.0"
requests:
  - provider: "OUAA"
    requirements:
      - configType: "Position"
        isRemoval: false
        tenants:
          - "all"
        vargs:
          - name: "副总经理"
          - name: "古河云测试职位"
          - name: "员工"
          - name: "总经理"
          - name: "总经理助理"
          - name: "董事长"
          - name: "部门主管"
          - name: "部门副经理"
          - name: "部门经理"
      - configType: "Role"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          prodCode: "ibimops-manege"
        vargs:
          - name: "超管"
            remark: "所有权限\n"
      - configType: "RoleTerminal"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          prodCode: "ibimops-manege"
