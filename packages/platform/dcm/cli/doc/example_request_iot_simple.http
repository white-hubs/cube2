      - configType: "ProdModel"
        isRemoval: false
        tenants:
          - "all"
        vargs:
          - brand: "曼顿"
            name: "三相电气监测仪"
            isCustom: 1
            category: "A006003"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "u"
                name: "电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "ua"
                name: "A相电压"
