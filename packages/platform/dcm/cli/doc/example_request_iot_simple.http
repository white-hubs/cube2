### 应用/DIFF系统配置差异-non-partial-Simple
POST http://{{baseurl}}/dcm/config/apply?type=DictType
Content-Type: application/yaml
Accept: application/yaml;charset=utf-8

schemaVersion: "1.0"
requests:
  - provider: "IOT"
    isPartialMode: false
    requirements:
      - configType: "DictType"
        isRemoval: false
        vargs:
          - name: "产品品类"
            code: "prod_category"
            remark: "产品品类"
          - name: "产品品牌"
            code: "prod_brand"
            remark: "产品品牌"
          - name: "设备型号"
            code: "prod_number"
            remark: "设备型号"
          - name: "属性单位"
            code: "prop_unit"
            remark: "属性单位"
          - name: "事件类型"
            code: "event_type"
            remark: "事件类型"
          - name: "直连设备接入方式"
            code: "direct_node_acc"
            remark: "直连设备接入方式"
          - name: "网关设备接入方式"
            code: "gateway_node_acc"
            remark: "网关设备接入方式"
          - name: "网关子设备接入方式"
            code: "gw_child_node_acc"
            remark: "网关子设备接入方式"



### 应用/DIFF租户配置差异-partial-Simple
POST http://{{baseurl}}/dcm/config/apply?tenant=41850024
Content-Type: application/yaml
Accept: application/yaml;charset=utf-8

---
schemaVersion: "1.0"
requests:
  - provider: "IOT"
    requirements:
      - configType: "DictEntry"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          typeCode: "event_type"
        vargs:
          - key: "info"
            label: "信息"
            remark: "info"
          - itemSort: 2
            key: "alarm"
            label: "告警"
            remark: "alarm"
          - itemSort: 3
            key: "fault"
            label: "故障"
            remark: "fault"
      - configType: "DictEntry"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          typeCode: "gateway_node_acc"
        vargs:
          - key: "mqtt"
            label: "mqtt"
            remark: "mqtt"
      - configType: "DictEntry"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          typeCode: "gw_child_node_acc"
        vargs:
          - key: "any"
            label: "any"
            remark: "any"
      - configType: "DictEntry"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          typeCode: "prod_brand"
        vargs:
          - key: "大华"
            label: "大华"
          - key: "恒星"
            label: "恒星"
          - key: "曼顿"
            label: "曼顿"
          - key: "海康"
            label: "海康"
          - key: "古河云"
            label: "古河云"
          - key: "安科瑞"
            label: "安科瑞"
          - key: "西门子"
            label: "西门子"
          - itemSort: 0
            key: "北大青鸟"
            label: "北大青鸟"
          - key: "南宁迈世"
            label: "南宁迈世"
          - key: "江森自控"
            label: "江森自控"
          - key: "霍尼韦尔"
            label: "霍尼韦尔"
      - configType: "DictEntry"
        isRemoval: false
        tenants:
          - "all"
        kwargs:
          typeCode: "prod_category"
        vargs:
          - key: "A001"
            label: "人员通行"
