                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "ia"
                name: "A相电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "ib"
                name: "B相电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "ic"
                name: "C相电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "temp_a"
                name: "A相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-50.0,100.0]"
              - code: "temp_b"
                name: "B相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-20.0,100.0]"
              - code: "temp_c"
                name: "C相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-20.0,100.0]"
          - brand: "曼顿"
            name: "三相电气监测仪(线电压)"
            isCustom: 1
            category: "A006003"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "u"
                name: "电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "uab"
                name: "AB线电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "ubc"
                name: "BC线电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "uac"
                name: "AC线电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "i"
                name: "电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "iab"
                name: "AB线电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "ibc"
                name: "BC线电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "iac"
                name: "AC线电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,200.0]"
              - code: "temp_a"
                name: "A相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-30.0,100.0]"
              - code: "temp_b"
                name: "B相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-30.0,100.0]"
              - code: "temp_c"
                name: "C相温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-30.0,100.0]"
          - brand: "安科瑞"
            name: "单相UPS"
            isCustom: 1
            category: "A007001"
            nodeType: "3"
            accessType: "any"
          - brand: "安科瑞"
            name: "三相UPS"
            isCustom: 1
            category: "A007001"
            nodeType: "3"
            accessType: "any"
          - brand: "南宁迈世"
            name: "温湿度传感器"
            isCustom: 1
            category: "A015001"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "temp"
                name: "温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-20.0,100.0]"
              - code: "hum"
                name: "湿度"
                dataType: "float"
                precision: 1
                unit: "%"
                dataConfig: "[0.0,100.0]"
          - brand: "恒星"
            name: "无线水压变送器"
            isCustom: 1
            category: "A009011"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "pressure"
                name: "水压"
                dataType: "float"
                precision: 3
                dataConfig: "[0.0,1.6]"
          - brand: "西门子"
            name: "浓度检测仪"
            isCustom: 1
            category: "A015002"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "ppm"
                name: "气体浓度"
                dataType: "float"
                precision: 2
                dataConfig: "[0.0,100.0]"
          - brand: "海康"
            name: "摄像头"
            isCustom: 1
            category: "A003001"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "online_status"
                name: "通讯状态"
                dataType: "boolean"
                precision: 4
                dataConfig: "[{\"value\":0,\"label\":\"异常\"},{\"value\":1,\"label\":\"正常\"\
          }]"
            events:
              - code: "flame"
                name: "明火"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "smoke"
                name: "烟雾"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "illegalParking"
                name: "车辆违停"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "occupationOfRoad"
                name: "占道经营"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "trafficCongestion"
                name: "车辆拥堵"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "blockingFireLane"
                name: "占用消防通道"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "intrusion"
                name: "入侵"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "clutteredStorage"
                name: "杂物堆放"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
              - code: "smoking"
                name: "抽烟"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{},\"triggerType\":\"NATURE\"}"
          - brand: "西门子"
            name: "通讯广播"
            isCustom: 1
            category: "A004002"
            nodeType: "3"
            accessType: "any"
          - brand: "古河云"
            name: "接入OS-网关"
            isCustom: 1
            category: "C017001"
            nodeType: "2"
            accessType: "mqtt"
            properties:
              - code: "online_status"
                name: "通讯状态"
                dataType: "boolean"
                precision: 4
                dataConfig: "[{\"value\":0,\"label\":\"异常\"},{\"value\":1,\"label\":\"正常\"\
          }]"
              - code: "volume"
                name: "音量"
                dataType: "int"
                precision: 4
                dataWrite: 1
                dataConfig: "[0,100]"
          - brand: "曼顿"
            name: "单相电气监测仪"
            isCustom: 1
            category: "A006003"
            nodeType: "3"
            accessType: "any"
            properties:
              - code: "u"
                name: "电压"
                dataType: "float"
                precision: 2
                unit: "V"
                dataConfig: "[0.0,500.0]"
              - code: "i"
                name: "电流"
                dataType: "float"
                precision: 2
                unit: "A"
                dataConfig: "[0.0,100.0]"
              - code: "temp"
                name: "温度"
                dataType: "float"
                precision: 2
                unit: "°C"
                dataConfig: "[-50.0,100.0]"
              - code: "i_delta"
                name: "剩余电流"
                dataType: "float"
                precision: 2
                dataConfig: "[0.0,500.0]"
            events:
              - code: "overVoltage"
                name: "电压过压"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{\"op\":\"GT\",\"delayTime\":60,\"\
          propCode\":\"u\",\"oprand\":[235.4]},\"triggerType\":\"SIMPLE\"}"
              - code: "underVoltage"
                name: "电压欠压"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{\"op\":\"LT\",\"delayTime\":60,\"\
          propCode\":\"u\",\"oprand\":[204.6]},\"triggerType\":\"SIMPLE\"}"
              - code: "overTemperature"
                name: "过温"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{\"op\":\"GT\",\"delayTime\":60,\"\
          propCode\":\"temp\",\"oprand\":[70]},\"triggerType\":\"SIMPLE\"}"
              - code: "leakageCurrent"
                name: "漏电流"
                category: "alarm"
                config: "{\"eventRelatedProp\":[],\"rules\":{\"op\":\"GT\",\"delayTime\":60,\"\
          propCode\":\"i_delta\",\"oprand\":[300]},\"triggerType\":\"SIMPLE\"}"
