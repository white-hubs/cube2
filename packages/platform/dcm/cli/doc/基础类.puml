@startuml
'https://plantuml.com/class-diagram

class BizEntity
class DcmEntity

class DcmDeclaration {
    String schemaVersion;
    String dataVersion;
    ModuleCommonSpec common;
    List<ProvidedConfigSpec> provides;
    List<DcmRequirements> requests;
}

class DcmRequirements {
    String provider;
    Boolean isPartialMode;
    List<RequestedConfigItem> requirements;
}

class RequestedConfigItem {
    String configType;
    Boolean isSystem;
    Boolean isPartial;
    Boolean isRemoval;
    List<String> tenants;
    Map<String, String> kwargs;
    List<Object> vargs;
}

class RequestedConfigItemParam {
    String configType;
    Boolean isMandatory;
    Boolean isRemoval;
    Boolean isSystem;
    Object tenants;
    Map<String, String> kwargs;
    List<Object> vargs;
}

DcmDeclarationParam o-R- DcmRequirementsParam
DcmRequirementsParam o-R- RequestedConfigItemParam

DcmDeclaration o-R- DcmRequirements
DcmRequirements o-R- RequestedConfigItem

DcmDeclaration -U- DcmDeclarationParam  : 映射
DcmRequirements -U- DcmRequirementsParam : 映射
RequestedConfigItem  -U- RequestedConfigItemParam : 映射

RequestedConfigItem "1" -- "1..*" DcmEntity : 转换

DcmEntity "1" -- "1" BizEntity : 转换


@enduml
