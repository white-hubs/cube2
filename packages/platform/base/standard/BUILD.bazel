load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//packages:__subpackages__"])

java_library(
    name = "exception",
    srcs = glob(["exception/*.java"]),
    deps = [
        "//packages/platform/base/utils:list",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:string",
    ],
)

java_library(
    name = "http",
    srcs = glob(["http/*.java"]),
    exports = [
        "//third-party/java/jackson:databind",
    ],
    deps = [
        "//third-party/java/apache:hc5",
        "//third-party/java/apache:hc5-client",
        "//third-party/java/jackson:databind",
        "//third-party/java/spring:spring_web",
    ],
)

java_library(
    name = "jackson",
    srcs = glob(["jackson/**/*.java"]),
    deps = [
        "//packages/platform/base/constants:date",
        "//packages/platform/base/model:models",
        "//packages/platform/base/utils:assert",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:desensitize",
        "//packages/platform/base/utils:regex",
        "//packages/platform/base/utils:string",
        "//third-party/java/jackson:annotations",
        "//third-party/java/jackson:core",
        "//third-party/java/jackson:databind",
        "//third-party/java/jackson:datatype",
        "//third-party/java/lombok:lombok_processor",
    ],
)
