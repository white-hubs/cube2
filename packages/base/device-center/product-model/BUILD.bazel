load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin", "java_test", "java_toolchain")
load("@rules_jvm_external//:defs.bzl", "artifact", "java_export", "maven_bom")
load("//packages/base/device-center/product-model:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:export.bzl", "export")
load("//packages/deploy/tools:server_info.bzl", "server_info")
load("//tools/springboot:springboot.bzl", "springboot")

java_library(
    name = "deps",
    visibility = ["//visibility:private"],
    exports = [
        "//packages/base/file/client",
        "//packages/base/ouaa/client",
        "//packages/platform/base/utils:pinyin",
        "//packages/platform/base/model:models",
        "//packages/platform/base/utils:bean",
        "//packages/platform/base/utils:collection",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:digest",
        "//packages/platform/base/utils:id",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:string",
        "//packages/platform/database",
        "//packages/platform/dcm/server-support",
        "//packages/platform/event",
        "//packages/platform/rocketmq",
        "//packages/platform/security",
        "//packages/platform/server",
        "//third-party/java/afterturn:easypoi",
        "//third-party/java/alibaba:easyexcel_core",
        "//third-party/java/apache:poi",
        "//third-party/java/apache:tomcat_annotations_api_legacy",
        "//third-party/java/apache:tomcat_embed_core",
        "//third-party/java/clickhouse:jdbc",
        "//third-party/java/codehaus:janino_commons_compiler",
        "//third-party/java/google:guava",
        "//third-party/java/hibernate:validator",
        "//third-party/java/jackson:annotations",
        "//third-party/java/jackson:core",
        "//third-party/java/jackson:databind",
        "//third-party/java/jakarta:annotation_api",
        "//third-party/java/jodd:core",
        "//third-party/java/netty:common",
        "//third-party/java/zaxxer:hikari_cp",
    ],
)

java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [
        ":deps"
    ],
)

_MAIN_CLASS = "com.guhecloud.cube.base.iot.product.model.ProductModelApplication"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)


java_library(
    name = "product-model",
    srcs = glob(["src/v3/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [
        ":deps",
    ],
)


server_info(
    name = "server-info",
    database = "cube_base_iot_product_model",
    datasource_package = "com.guhecloud.cube.base.iot.product.model",
    gw_prefix = "/product-model/",
    main_class = _MAIN_CLASS,
    server = ":server",
    server_id = "productModel",
    visibility = ["//packages:__subpackages__"],
)
