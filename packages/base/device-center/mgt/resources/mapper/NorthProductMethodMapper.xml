<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.iot.mgt.north.mapper.NorthProductMethodMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.iot.mgt.things.model.MdProductMethod">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="prod_id" jdbcType="BIGINT" property="prodId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="method_code" jdbcType="VARCHAR" property="methodCode"/>
        <result column="description" jdbcType="VARCHAR" property="description"/>
        <result column="method_type" jdbcType="VARCHAR" property="methodType"/>
        <result column="input_params" jdbcType="LONGVARCHAR" property="inputParams"/>
        <result column="output_params" jdbcType="LONGVARCHAR" property="outputParams"/>
        <result column="timeout_ms" jdbcType="INTEGER" property="timeoutMs"/>
        <result column="retryable" jdbcType="INTEGER" property="retryable"/>
        <result column="max_retries" jdbcType="INTEGER" property="maxRetries"/>
        <result column="status" jdbcType="INTEGER" property="status"/>
        <result column="extend_config" jdbcType="LONGVARCHAR" property="extendConfig"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>

    <select id="queryProductMethod" resultType="com.guhecloud.cube.iot.mgt.north.vo.ProductMethodVo">
        select `method`.`name`          as `name`,
               `method`.`method_code`   as `methodCode`,
               `method`.`description`   as `description`,
               `method`.`method_type`   as `methodType`,
               `method`.`input_params`  as `inputParamsStr`,
               `method`.`output_params` as `outputParamsStr`,
               `method`.`timeout_ms`    as `timeoutMs`,
               DATE_FORMAT(`method`.`create_time`, '%Y-%m-%d %H:%i:%s') as `createTimeFormat`
        from `iot_md_product_method` `method`
        where `method`.`prod_id` = #{prodId}
          and `method`.`status` = 0
    </select>
</mapper>
