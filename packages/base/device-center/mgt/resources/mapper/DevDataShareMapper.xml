<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.iot.mgt.device.mapper.DevDataShareMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.iot.mgt.device.model.DevDataShare">
        <!--@mbg.generated-->
        <!--@Table iot_dev_data_share-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="source_device_id" jdbcType="BIGINT" property="sourceDeviceId"/>
        <result column="source_product_id" jdbcType="BIGINT" property="sourceProductId"/>
        <result column="source_data_type" jdbcType="TINYINT" property="sourceDataType"/>
        <result column="source_data_id" jdbcType="BIGINT" property="sourceDataId"/>
        <result column="source_data_code" jdbcType="VARCHAR" property="sourceDataCode"/>
        <result column="target_device_id" jdbcType="BIGINT" property="targetDeviceId"/>
        <result column="target_product_id" jdbcType="BIGINT" property="targetProductId"/>
        <result column="target_data_id" jdbcType="BIGINT" property="targetDataId"/>
        <result column="target_data_code" jdbcType="VARCHAR" property="targetDataCode"/>
        <result column="share_mode" jdbcType="TINYINT" property="shareMode"/>
        <result column="extend_config" jdbcType="LONGVARCHAR" property="extendConfig"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        `id`, `source_device_id`, `source_product_id`, `source_data_type`, `source_data_id`, `source_data_code`,
        `target_device_id`, `target_product_id`, `target_data_id`, `target_data_code`, `share_mode`, `extend_config`,
        `remark`
    </sql>

    <select id="countAsSourceByDeviceIds" resultType="com.guhecloud.cube.iot.mgt.device.vo.DeviceIdCountVo">
        SELECT `source_device_id` AS `deviceId`, COUNT(*) AS `cnt`
        FROM `iot_dev_data_share`
        WHERE `source_device_id` IN
        <foreach collection="deviceIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND `deleted` = 0
        <if test="tenant != null">
            AND `tenant` = #{tenant}
        </if>
        GROUP BY `source_device_id`
    </select>

    <select id="countAsTargetByDeviceIds" resultType="com.guhecloud.cube.iot.mgt.device.vo.DeviceIdCountVo">
        SELECT `target_device_id` AS `deviceId`, COUNT(*) AS `cnt`
        FROM `iot_dev_data_share`
        WHERE `target_device_id` IN
        <foreach collection="deviceIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND `deleted` = 0
        <if test="tenant != null">
            AND `tenant` = #{tenant}
        </if>
        GROUP BY `target_device_id`
    </select>
</mapper>
