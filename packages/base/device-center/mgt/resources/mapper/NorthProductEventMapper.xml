<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.iot.mgt.north.mapper.NorthProductEventMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.iot.mgt.north.model.MdProductEvent">
        <!--@mbg.generated-->
        <!--@Table iot_md_product_event-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="prod_id" jdbcType="BIGINT" property="prodId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="event_code" jdbcType="VARCHAR" property="eventCode"/>
        <result column="config" jdbcType="LONGVARCHAR" property="config"  typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="category_id" jdbcType="BIGINT" property="categoryId"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        `id`, `prod_id`, `name`, `event_code`, `config`, `category_id`, `remark`
    </sql>

    <resultMap id="ProductEventVoMap" type="com.guhecloud.cube.iot.mgt.north.vo.ProductEventVo">
        <result column="eventCode" property="eventCode"/>
        <result column="eventName" property="eventName"/>
        <result column="config" property="eventConfig" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="remark" property="remark"/>
        <result column="categoryName" property="categoryName"/>
        <result column="categoryCode" property="categoryCode"/>
    </resultMap>

    <select id="queryProductEvent" resultMap="ProductEventVoMap">
        select `event`.`event_code`    as `eventCode`,
               `event`.`name`          as `eventName`,
               `event`.`config`        as `config`,
               `event`.`remark`        as `remark`,
               `category`.`item_label` as `categoryName`,
               `category`.`item_level` as `categoryCode`
        from `iot_md_product_event` `event`
                 left join `iot_sys_dict_item` `category` on `event`.`category_id` = `category`.`id`
        where `event`.`prod_id` = #{prodId}
    </select>

    <select id="queryProductEventDesignatedCode" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from `iot_md_product_event`
        where `prod_id` = #{prodId} and `event_code` = #{eventCode}
    </select>
</mapper>