<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.iot.mgt.north.mapper.NorthProductPropMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.iot.mgt.north.model.MdProductProp">
        <!--@mbg.generated-->
        <!--@Table iot_md_product_prop-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="prod_id" jdbcType="BIGINT" property="prodId"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="prop_code" jdbcType="VARCHAR" property="propCode"/>
        <result column="data_type" jdbcType="VARCHAR" property="dataType"/>
        <result column="precision" jdbcType="INTEGER" property="precision"/>
        <result column="unit_id" jdbcType="BIGINT" property="unitId"/>
        <result column="data_write" jdbcType="INTEGER" property="dataWrite"/>
        <result column="data_config" jdbcType="LONGVARCHAR" property="dataConfig"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        `id`, `prod_id`, `name`, `prop_code`, `data_type`, `precision`, `unit_id`, `data_write`, `data_config`,
        `remark`
    </sql>

    <select id="queryProductProp" resultType="com.guhecloud.cube.iot.mgt.north.vo.ProductPropVo">
        select `prop`.`prop_code`   as `propCode`,
               `prop`.`name`        as `propName`,
               `prop`.`data_type`   as `dataType`,
               `prop`.`precision`   as `precision`,
               `unit`.`unit_name`   as `unitName`,
               `prop`.`data_write`  as `dataWrite`,
               `prop`.`data_config` as `dataConstraintStr`,
               `prop`.`remark`      as `remark`
        from `iot_md_product_prop` `prop`
                 left join `iot_sys_unit` `unit` on `prop`.`unit_code` = `unit`.`unit_code`
        where `prop`.`prod_id` = #{prodId}
    </select>
</mapper>