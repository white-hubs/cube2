<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.iot.mgt.base.mapper.SysDictMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.iot.mgt.base.model.SysDict">
        <!--@mbg.generated-->
        <!--@Table iot_sys_dict-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="dict_name" jdbcType="VARCHAR" property="dictName"/>
        <result column="dict_code" jdbcType="VARCHAR" property="dictCode"/>
        <result column="status" jdbcType="BOOLEAN" property="status"/>
        <result column="type" jdbcType="BOOLEAN" property="type"/>
        <result column="remark" jdbcType="VARCHAR" property="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        `id`, `dict_name`, `dict_code`, `status`, `type`, `remark`
    </sql>

    <select id="queryAllSysDictNoTenant" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from `iot_sys_dict` `dict` where `dict`.`type` = 0
    </select>

    <select id="queryAllByTenantId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from `iot_sys_dict` `dict`
        where `dict`.`tenant_id` = #{tenantId}
    </select>
</mapper>