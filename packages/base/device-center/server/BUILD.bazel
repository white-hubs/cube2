load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin", "java_test", "java_toolchain")
load("@rules_jvm_external//:defs.bzl", "artifact", "java_export", "maven_bom")
load("//packages/base/device-center:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:export.bzl", "export")
load("//packages/deploy/tools:server_info.bzl", "server_info")
load("//tools/springboot:springboot.bzl", "springboot")

java_library(
    name = "deps",
    visibility = ["//visibility:private"],
    exports = [
        "//packages/apps/maintain/client",
        "//packages/base/alarm/client",
        "//packages/base/device-center/metadata",
        "//packages/base/device-center/mgt",
        "//packages/base/device-center/north/client",
        "//packages/base/device-center/north/consumer",
        "//packages/base/dictionary/client",
        "//packages/base/file/client",
        "//packages/base/mdata/client",
        "//packages/base/ouaa/client",
        "//packages/platform/base/model:models",
        "//packages/platform/base/standard:jackson",
        "//packages/platform/base/utils:collection",
        "//packages/platform/base/utils:convert",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:id",
        "//packages/platform/base/utils:json",
        "//packages/platform/base/utils:list",
        "//packages/platform/base/utils:map",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:string",
        "//packages/platform/database",
        "//packages/platform/dcm/server-support",
        "//packages/platform/event",
        "//packages/platform/liquibase",
        "//packages/platform/redis",
        "//packages/platform/rocketmq",
        "//packages/platform/security",
        "//packages/platform/server",
        "//third-party/java/alibaba:fastjson2",
        "//third-party/java/apache:poi",
        "//third-party/java/apache:tomcat_embed_core",
        "//third-party/java/google:guava",
        "//third-party/java/hibernate:validator",
        "//third-party/java/hutool:poi",
        "//third-party/java/jackson",
        "//third-party/java/jakarta:annotation_api",
        "//third-party/java/networknt:json_schema_validator",
        "//third-party/java/spring:spring_boot_starter_jdbc",
    ],
)

java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [":deps"],
)

_MAIN_CLASS = "com.guhecloud.cube.base.device.center.DeviceCenterServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

artifactId = "cube-base-device-center-server"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":server"],
)

server_info(
    name = "server-info",
    database = "cube_base_iot_center",
    datasource_package = "com.guhecloud.cube.base.device.center",
    gw_prefix = "/device-center/,/iot/",
    legacy_datasource_packages = ["com.guhecloud.cube.iot.mgt"],
    main_class = _MAIN_CLASS,
    public_path_patterns = "/websocket/**,/megbox/report-match,/websocket/workers",
    server = ":server",
    server_id = "iotDeviceCenter",
    visibility = ["//packages:__subpackages__"],
)

java_test(
    name = "tag-rule-device-change-consumer-tests",
    srcs = ["tests/core/rule/tag/rocketmq/consumer/TagRuleDeviceChangeConsumerTest.java"],
    test_class = "com.guhecloud.cube.base.device.center.core.rule.tag.rocketmq.consumer.TagRuleDeviceChangeConsumerTest",
    deps = [
        ":server",
        "//packages/base/device-center/metadata",
        "//third-party/java/junit",
    ],
)

java_test(
    name = "device-duplicate-rule-tests",
    srcs = ["tests/core/mapper/CenterBizDeviceMapperDuplicateRuleTest.java"],
    test_class = "com.guhecloud.cube.base.device.center.core.mapper.CenterBizDeviceMapperDuplicateRuleTest",
    deps = [
        ":server",
        "//third-party/java/junit",
    ],
)
