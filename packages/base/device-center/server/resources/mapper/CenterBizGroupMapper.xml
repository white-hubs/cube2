<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.base.device.center.core.mapper.CenterBizGroupMapper">

    <update id="logicDeleteByIds">
        <!--@mbg.generated-->
        UPDATE `center_biz_group`
        SET `deleted` = #{deleted},
        `update_time` = #{updateTime},
        `update_by` = #{username,jdbcType=VARCHAR},
        `updater_id` = #{userId,jdbcType=VARCHAR},
        `updater_type` = #{userType,jdbcType=VARCHAR}
        WHERE `id` IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>