        <result column="tag_name" jdbcType="VARCHAR" property="tagName"/>
    </resultMap>

    <resultMap id="DeviceRefTagMap" type="com.guhecloud.cube.base.device.center.metadata.vo.DeviceRefTagVO">
        <id column="id" property="id"/>
        <collection property="tags" javaType="java.util.ArrayList"
                    ofType="com.guhecloud.cube.base.device.center.metadata.std.vo.CustomerTagVO">
            <result column="tag_id" property="id"/>
            <result column="tag_name" property="tagName"/>
            <result column="tag_code" property="tagCode"/>
            <result column="description" property="description"/>
            <result column="update_time" property="updateTime"/>
            <result column="enable_status" property="enableStatus"/>
        </collection>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        `id`, `tag_code`, `tag_name`
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        <!--@mbg.generated-->
        SELECT
        <include refid="Base_Column_List"/>
        FROM `center_biz_tag`
        WHERE `id` = #{id,jdbcType=BIGINT}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        <!--@mbg.generated-->
        DELETE FROM `center_biz_tag`
        WHERE `id` = #{id,jdbcType=BIGINT}
    </delete>

    <insert id="insertSelective" parameterType="com.guhecloud.cube.base.device.center.core.model.BizTag">
        <!--@mbg.generated-->
        INSERT INTO `center_biz_tag`
