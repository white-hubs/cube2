<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.base.device.center.core.mapper.CenterBizTagMapper">
    <resultMap id="BaseResultMap" type="com.guhecloud.cube.base.device.center.core.model.BizTag">
        <!--@mbg.generated-->
        <!--@Table center_biz_tag-->
        <id column="id" jdbcType="BIGINT" property="id"/>
