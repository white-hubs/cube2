<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.base.device.center.statistics.mapper.BizDeviceStateLogMapper">
    <select id="getLastState" resultType="java.lang.Integer">
        select `device_state`
        from `center_biz_device_state_log`
        where `device_id` = #{deviceId,jdbcType=BIGINT}
        order by `create_time` desc
        limit 1
    </select>

    <select id="selectLogByDeviceId"
            resultType="com.guhecloud.cube.base.device.center.statistics.model.BizDeviceStateLog">
        select *
        from `center_biz_device_state_log`
        where `device_id` = #{deviceId,jdbcType=BIGINT}
        order by `create_time` asc
    </select>

    <select id="countOffLineNum" resultType="java.lang.Integer">
        select count(*)
        from `center_biz_device_state_log`
        where `device_id` = #{deviceId,jdbcType=BIGINT}
          and `device_state` = 0;
    </select>
</mapper>