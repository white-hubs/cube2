    <update id="logicDeleteByDeviceIds">
        UPDATE `center_biz_device_ref`
        SET `deleted` = 1,
        `update_time` = #{updateTime},
        `update_by` = #{userId,jdbcType=VARCHAR},
        `updater_id` = #{userId,jdbcType=VARCHAR},
        `updater_type` = #{userType,jdbcType=VARCHAR}
        WHERE `device_id` IN
        <foreach collection="deviceIds" item="deviceId" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </update>

    <update id="updateBySelective">
        UPDATE `center_biz_device_ref`
        <set>
            <if test="deviceRef.updateBy != null">
                `update_by` = #{deviceRef.updateBy,jdbcType=VARCHAR},
            </if>
            <if test="deviceRef.updaterId != null">
                `updater_id` = #{deviceRef.updaterId,jdbcType=VARCHAR},
            </if>
            <if test="deviceRef.updaterType != null">
                `updater_type` = #{deviceRef.updaterType,jdbcType=VARCHAR},
            </if>
            <if test="deviceRef.updateTime != null">
                `update_time` = #{deviceRef.updateTime,jdbcType=TIMESTAMP},
            </if>
            <if test="deviceRef.deleted">
                `deleted` = 1,
            </if>
            <if test="!deviceRef.deleted">
                `deleted` = 0,
            </if>
        </set>
        WHERE `device_id` = #{deviceRef.deviceId,jdbcType=BIGINT}
    </update>
