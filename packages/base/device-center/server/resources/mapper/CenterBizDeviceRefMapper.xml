        INSERT INTO `center_biz_device_ref` (`device_id`, `ref_device_id`)
        VALUES (#{deviceId,jdbcType=BIGINT}, #{refDeviceId,jdbcType=BIGINT})
    </insert>

    <select id="findRefDeviceIds" resultType="java.lang.String">
        <!--@mbg.generated-->
        SELECT `ref_device_id` FROM `center_biz_device_ref` WHERE `device_id` = #{deviceId,jdbcType=BIGINT}
    </select>

    <update id="removeRefDevice">
        <!--@mbg.generated-->
        UPDATE `center_biz_device_ref`
        SET `deleted` = 1,
        `update_time` = #{updateTime}
        WHERE `device_id` = #{deviceId,jdbcType=BIGINT}
    </update>

    <insert id="saveRef">
        <!--@mbg.generated-->
        INSERT INTO `center_biz_device_ref` (`device_id`, `ref_device_id`, `create_by`, `update_by`)
        VALUES (#{deviceId,jdbcType=BIGINT}, #{refDeviceId,jdbcType=BIGINT}, #{username},
