<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.mdata.server.goods.dao.GoodsCategoryMapper">

    <sql id="Basic_Query_Column">
        id,code,name,level,parent_id,sequence,enabled,tenant,deleted,`create_by`,`creator_id`,`creator_type`,`create_time`,`update_by`,`updater_id`,`updater_type`,`update_time`
    </sql>

    <select id="getBySequences" resultType="com.guhecloud.cube.biz.mdata.server.goods.entity.GoodsCategory">
        select
        <include refid="Basic_Query_Column" />
        from goods_category
        <where>
            <if test="sequences != null and sequences.size() > 0">
                and sequence in
                <foreach collection="sequences" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getThirdLevel" resultType="com.guhecloud.cube.biz.mdata.server.goods.entity.GoodsCategory">
        select
        <include refid="Basic_Query_Column" />
        from goods_category
        <where>
            <if test="sequences != null and sequences.size() > 0">
                and sequence in
                <foreach collection="sequences" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="level != null">
                and `level` = #{level}
            </if>
        </where>
    </select>

    <select id="getThirdLevelByIds" resultType="com.guhecloud.cube.biz.mdata.server.goods.entity.GoodsCategory">
        select
        <include refid="Basic_Query_Column" />
        from goods_category
        <where>
            <if test="ids != null and ids.size() > 0">
                id in
                <foreach collection="ids" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
            <if test="level != null">
                and `level` = #{level}
            </if>
        </where>
    </select>

    <select id="getIdsByParentIds" resultType="java.lang.String">
        select id
        from goods_category
        where
        parent_id in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>

    <select id="getNameByIds" resultType="java.lang.String">
        select name
        from goods_category
        where
        id in
        <foreach collection="list" item="item" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </select>
</mapper>