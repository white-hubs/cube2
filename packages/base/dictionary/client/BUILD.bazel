load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_jvm_external//:defs.bzl", "artifact", "java_export", "maven_bom")
load("//packages/base/dictionary:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")

package(default_visibility = ["//packages:__subpackages__"])

java_library(
    name = "client",
    srcs = glob(["src/**/*.java"]),
    deps = [
        "//packages/platform/base/model:pagination",
        "//packages/platform/base/model:paging",
        "//packages/platform/base/utils:collection",
        "//packages/platform/base/utils:map",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:reflect",
        "//packages/platform/base/utils:string",
        "//packages/platform/base/utils:json",
        "//packages/platform/client",
        "//packages/platform/security",
        "//third-party/java/jackson:core",
    ],
)

artifactId = "cube-base-dictionary-client"

java_export(
    name = "export",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":client",
    ],
)

java_export(
    name = "export-dev",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION_DEV),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":client",
    ],
)

java_export(
    name = "export-test",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION_TEST),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":client",
    ],
)
