<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.ouaa.server.dao.RoleMenuFunctionMapper">

	<delete id="removeByRoleMenuIds">
		DELETE FROM `ouaa_role_menu_function`
		WHERE (`menu_id`, `role_id`) IN (
		SELECT `menu_id`, `role_id`
		FROM `ouaa_role_menu`
		WHERE `id` IN
		<foreach collection="roleMenuIds" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
		)
	</delete>
</mapper>
