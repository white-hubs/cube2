<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.ouaa.server.dao.TenantApplicationMapper">

    <select id="selectListByTenantProductApplications"
            resultType="com.guhecloud.cube.biz.ouaa.server.entity.TenantApplication">
        SELECT
        ta.`id`,
        ta.`tenant`,
        ta.`product_id`,
        ta.`application_id`
        FROM
        `tenant_application` ta
        <where>
            1=1
            <if test="tenant != null">
                and ta.`tenant` = #{tenant}
            </if>
            <if test="productId != null">
                AND ta.`product_id` = #{productId}
            </if>
            <if test="applicationIds !=null and applicationIds.size > 0">
                and ta.`application_id` in
                <foreach collection="applicationIds" item="id" open="(" close=")"
                         separator=",">
                    #{id}
                </foreach>
            </if>
        </where>
    </select>
</mapper>