<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.base.flow.context.dao.FormFlowMapper">
    <select id="selectAutoRemoveDuplication"
            resultType="com.guhecloud.cube.base.flow.context.interfaces.vo.FormFlowDetailVO">
        SELECT
            ff.form_key,
            ff.auto_remove_duplication
        FROM
            form_flow_business ffb
            JOIN form_flow ff ON ff.id = ffb.form_flow_id
        WHERE
            ffb.business_type = #{businessType}

    </select>
</mapper>
