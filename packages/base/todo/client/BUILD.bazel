load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_jvm_external//:defs.bzl", "java_export")
load("//packages/base/todo:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:export.bzl", "export")

package(default_visibility = ["//packages:__subpackages__"])

java_library(
    name = "deps",
    visibility = ["//visibility:private"],
    exports = [
        "//packages/platform/base/model:period",
        "//packages/platform/client",
        "//third-party/java/alibaba:fastjson2",
        "//third-party/java/jackson",
    ],
)

java_library(
    name = "client",
    srcs = glob(["src/**/*.java"]),
    deps = [":deps"],
)

artifactId = "todo-client"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":client"],
)