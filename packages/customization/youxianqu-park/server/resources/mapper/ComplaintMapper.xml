<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.customized.youxianqu.park.management.server.complaint.mapper.ComplaintMapper">

    <select id="selectTrend"
            resultType="com.guhecloud.cube.customized.youxianqu.park.management.server.common.vo.result.TrendResult">
        select DATE_FORMAT(CREATE_TIME,#{format}) as trendX,count(id) as trendY
        from ZHYQ_COMPLAINT
        <where>
            <if test="period != null and period.begin != null">
                and CREATE_TIME &gt;= #{period.begin}
            </if>
            <if test="period != null and period.end != null">
                and CREATE_TIME &lt;= #{period.end}
            </if>
        </where>
        group by trendX
    </select>
</mapper>