<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.medical.cleanliness.server.detection.repo.mapper.DetectionReportRecordMapper">
    <select id="getRecordSourceList" resultType="String">
        SELECT
        source_list
        FROM detection_report_record drr
        WHERE
         drr.deleted = 0
         AND drr.id=#{recordId}
    </select>
</mapper>