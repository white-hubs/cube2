java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [":deps"],
)

_MAIN_CLASS = "com.guhecloud.cube.srv.gen.medical.cleanliness.server.MedicalCleanlinessServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)

artifactId = "cube-srv-gen-medical-cleanliness-server"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

server_info(
    name = "server-info",
    database = "cube_srv_gen_medical_cleanliness",
    datasource_package = "com.guhecloud.cube.srv.gen.medical.cleanliness",
    gw_prefix = "/medical-cleanliness/",
    main_class = _MAIN_CLASS,
    server = ":server",
    server_id = "medicalCleanliness",
    visibility = ["//packages:__subpackages__"],
)
