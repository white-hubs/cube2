<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.tj.electronic.guide.dao.TjPointManageMapper">
    <select id="selectPointManagePage" resultType="com.guhecloud.cube.srv.tj.electronic.guide.vo.PointManagePageVO">
        SELECT b.`name` as areaName,a.* FROM tj_point_manage a
        inner join `tj_guide_area_manage` b on a.area_id=b.id
        <where>
            <if test="param.areaId !=null">
                b.id=#{param.areaId}
            </if>
            <if test="param.keyword !=null and param.keyword !=''">
                and a.name like concat('%',#{param.keyword},'%')
            </if>
            <if test="param.state != null and param.state != ''">
                and a.state =#{param.state}
            </if>
        </where>
        order by `level`
    </select>
</mapper>