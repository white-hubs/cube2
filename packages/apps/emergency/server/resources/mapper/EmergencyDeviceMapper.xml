<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.emergency.server.dao.EmergencyDeviceMapper">

    <select id="getEmergencyDeviceStatForUsed"
            resultType="com.guhecloud.cube.biz.emergency.server.vo.EmergencyDeviceStatVO">
        select sum(device_num)as total,sum(device_used_num) as usedValue
        from emergency_device
    </select>
</mapper>