load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin", "java_test", "java_toolchain")
load("@rules_jvm_external//:defs.bzl", "artifact", "java_export", "maven_bom")
load("//packages/apps/metric:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:export.bzl", "export")
load("//packages/deploy/tools:server_info.bzl", "server_info")
load("//tools/springboot:springboot.bzl", "springboot")

java_library(
    name = "deps",
    visibility = ["//visibility:private"],
    exports = [
        "//packages/apps/loose-works/client",
        "//packages/apps/maintain/client",
        "//packages/apps/safety-management/client",
        "//packages/base/alarm/client",
        "//packages/base/device-center/client",
        "//packages/base/device-center/supervise/client",
        "//packages/base/dictionary/client",
        "//packages/base/ouaa/client",
        "//packages/base/process-engine/client",
        "//packages/platform/base/model:models",
        "//packages/platform/base/standard:exception",
        "//packages/platform/base/standard:http",
        "//packages/platform/base/utils:collection",
        "//packages/platform/base/utils:compress",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:json",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:string",
        "//packages/platform/base/utils:tree",
        "//packages/platform/database",
        "//packages/platform/event",
        "//packages/platform/liquibase",
        "//packages/platform/redis",
        "//packages/platform/rocketmq",
        "//packages/platform/security",
        "//packages/platform/server",
        "//third-party/java/alibaba:fastjson2",
        "//third-party/java/apache:hc5",
        "//third-party/java/apache:hc5-client",
        "//third-party/java/github:mouzt_bizlog_sdk",
        "//third-party/java/google:guava",
        "//third-party/java/jackson",
        "//third-party/java/jakarta:annotation_api",
        "//third-party/java/mvel:mvel2",
    ],
)

java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [":deps"],
)

_MAIN_CLASS = "com.guhecloud.cube.biz.metric.server.MetricServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

artifactId = "metric-server"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":server"],
)

server_info(
    name = "server-info",
    database = "cube_biz_metric",
    datasource_package = "com.guhecloud.cube.biz.metric",
    gw_prefix = "/metric/",
    main_class = _MAIN_CLASS,
    server = ":server",
    server_id = "metric",
    visibility = ["//packages:__subpackages__"],
)
