<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.safety.education.server.common.infrastructure.repository.mapper.CoursewareLibraryMapper">

    <select id="selectCoursewareLibraryPage"
            resultType="com.guhecloud.cube.srv.gen.safety.education.server.common.interfaces.vo.CoursewareLibraryVO">
        SELECT
        cl.id,
        cl.`name`,
        cl.theme_id,
        th.`name` as theme_name,
        cl.file_id,
        cl.remark,
        cl.duration
        FROM
        courseware_library cl
        LEFT JOIN theme th on cl.theme_id = th.id
        <where>
            <if test="query.keyword != null and query.keyword != ''">
                and (cl.name like concat('%',#{query.keyword},'%')
                or
                th.name like concat('%',#{query.keyword},'%')
                )
            </if>
        </where>
        order by cl.create_time desc
    </select>
</mapper>