<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.content.management.server.knowledgedocument.dao.KnowledgeTypeMapper">

    <select id="getBySequences" resultType="com.guhecloud.cube.srv.gen.content.management.server.knowledgedocument.po.KnowledgeType">
        SELECT * from knowledge_type
        <where>
            <if test="sequences != null and sequences.size() > 0">
                and sequence in
                <foreach collection="sequences" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
        order by sequence
    </select>
</mapper>