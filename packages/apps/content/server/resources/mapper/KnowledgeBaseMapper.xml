<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.content.management.server.knowledgedocument.dao.KnowledgeBaseMapper">

    <select id="statKnowledgeGroupType" resultType="com.guhecloud.cube.srv.gen.content.management.server.knowledgedocument.interfaces.vo.KeyValueStringInteger">
        SELECT kt.name as `key`, count(kb.id) as `value`
        from knowledge_base kb left join knowledge_type kt
        on (kb.type_id = kt.id)
        group by kb.type_id
    </select>
</mapper>