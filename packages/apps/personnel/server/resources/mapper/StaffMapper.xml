    <select id="getStaffPageNotIn" resultType="com.guhecloud.cube.srv.gen.personnel.management.server.po.StaffPO">
        select s.`id` ,s.`name` ,s.`mobile` ,s.`organization_id` from `staff` s
        <where>
            <if test="param.organizationId != null and param.organizationId != '' ">
                s.`organization_id` = #{param.organizationId}
            </if>
            <if test="param.staffName != null and param.staffName != ''">
                and s.`name` LIKE CONCAT('%',#{param.staffName},'%')
            </if>
            <foreach collection="param.notInIds" item="id" open=" and s.id not in ( " separator="," close=")">
                #{id}
            </foreach>
        </where>
    </select>

