<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.smartcard.server.dao.EventRecordMapper">

    <select id="getEventStatByName" resultType="com.guhecloud.cube.biz.smartcard.server.vo.CommonStatVO">
        select event_name as name,count(id) as value from event_record
        where deleted = 0
        <if test="param.period != null and param.period.begin != null">
            and event_time &gt;= #{param.period.begin}
        </if>
        <if test="param.period != null and param.period.end != null">
            and event_time &lt; #{param.period.end}
        </if>
        group by event_name
        order by value desc
    </select>

</mapper>