<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.base.visualization.server.dao.ModelRouteMapper">
    <select id="maxLevel" resultType="java.lang.Integer">
        select max(`level`)
        from `model_route`
        where `model_id` = #{moderlId}
    </select>
</mapper>