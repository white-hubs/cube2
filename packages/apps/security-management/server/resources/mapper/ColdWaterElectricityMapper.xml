<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.securitymanagement.server.chilledwater.dao.ColdWaterElectricityMapper">

        <select id="getQuantityElectricity" resultType="com.guhecloud.cube.srv.gen.securitymanagement.server.chilledwater.entity.ColdWaterElectricity">
            SELECT `id`,`quantity_electricity` `quantityElectricity`,`device_id` `deviceId`,`last_reade` `lastReade`,`collection_time` `collectionTime` FROM `cold_water_electricity` WHERE `device_id`  = #{deviceId} and `collection_time` = #{date})
        </select>


    <select id="getColdWaterElectricity" resultType="java.math.BigDecimal">
        SELECT COALESCE(sum(`quantity_electricity`),0) FROM `cold_water_electricity`
        WHERE
            `collection_time` between #{startTime} and #{endTime}
    </select>


</mapper>