load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("@rules_jvm_external//:defs.bzl", "java_export")
load("//packages/apps/energy:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:export.bzl", "export")
load("//packages/deploy/tools:server_info.bzl", "server_info")
load("//tools/springboot:springboot.bzl", "springboot")

java_library(
    name = "deps",
    visibility = ["//visibility:private"],
    exports = [
        "//packages/apps/security-management/client",
        "//packages/apps/linkage/client",
        "//packages/base/alarm/client",
        "//packages/base/device-center/client",
        "//packages/base/device-center/north/client",
        "//packages/base/dictionary/client",
        "//packages/base/file/client",
        "//packages/base/mdata/client",
        "//packages/base/ouaa/client",
        "//packages/platform/base/constants:date",
        "//packages/platform/base/model:pagination",
        "//packages/platform/base/model:paging",
        "//packages/platform/base/model:period",
        "//packages/platform/base/model:requester",
        "//packages/platform/base/model:tree",
        "//packages/platform/base/utils:base64",
        "//packages/platform/base/utils:biz-code",
        "//packages/platform/base/utils:collection",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:json",
        "//packages/platform/base/utils:list",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:object-id",
        "//packages/platform/base/utils:string",
        "//packages/platform/base/utils:tree",
        "//packages/platform/database",
        "//packages/platform/event",
        "//packages/platform/job",
        "//packages/platform/liquibase",
        "//packages/platform/rocketmq",
        "//packages/platform/security",
        "//packages/platform/server",
        "//third-party/java/alibaba:fastjson2",
        "//third-party/java/alibaba:easyexcel",
        "//third-party/java/apache:poi",
        "//third-party/java/apache:tomcat_embed_core",
        "//third-party/java/dom4j",
        "//third-party/java/google:guava",
        "//third-party/java/hutool:poi",
        "//third-party/java/influxdb",
        "//third-party/java/jackson",
    ],
)

java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [
        ":deps",
    ],
)

_MAIN_CLASS = "com.guhecloud.cube.srv.gen.energymanagement.server.EnergyManagementServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

artifactId = "cube-srv-gen-energymanagement-server"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":server"],
)

server_info(
    name = "server-info",
    database = "cube-srv-gen-energy-management",
    datasource_package = "com.guhecloud.cube.srv.gen.energymanagement",
    gw_prefix = "/energymanagement/",
    main_class = _MAIN_CLASS,
    server = ":server",
    server_id = "energyManagement",
    visibility = ["//packages:__subpackages__"],
)
