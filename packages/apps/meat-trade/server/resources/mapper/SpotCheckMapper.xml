<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.biz.meattrade.server.pork.dao.SpotCheckMapper">

    <sql id="Basic_Column">
        s.id,s.pork_report_id,s.pork_report_code,s.inspector_id,s.actual_check_slices,s.required_check_ratio,s.required_check_slices,s.clenbuterol,s.watered,
        s.spot_check_time,s.remark
--         s.tenant_id,s.deleted,s.create_by,s.create_time,s.update_by,s.update_time
    </sql>

    <select id="pageSpotCheck" resultType="com.guhecloud.cube.biz.meattrade.server.pork.entity.SpotCheck">
        select
        <include refid="Basic_Column"/>
        from meattrade_spot_check s
        left join meattrade_pork_report p
        <where>
            <if test="param.keyword != null and param.keyword != ''">
                and (s.pork_report_code like concat("%",#{param.keyword},"%")
                <if test="param.supplierIds != null and param.supplierIds.size() > 0">
                    or p.supplier_id in
                    <foreach collection="param.supplierIds" item="supplierId" open="(" separator="," close=")">
                        #{supplierId}
                    </foreach>
                </if>
                )
            </if>
            <if test="param.status != null">
                and s.status = #{param.status}
            </if>
            and p.tenant = #{param.tenant}
            and s.tenant = #{param.tenant}
        </where>
        group by s.pork_report_code
    </select>

    <select id="selectSpotCheck" resultType="com.guhecloud.cube.biz.meattrade.server.pork.vo.SpotCheckVO">
        SELECT
        t1.id,
        t1.pork_report_id,
        t1.pork_report_code,
        t2.report_slices as pork_report_slices,
        t2.goods_category_id,
        t2.goods_category_name,
        t2.fresh_label,
        t2.supplier_id,
        t1.inspector_id,
        t1.actual_check_slices,
        t1.required_check_ratio,
        t1.required_check_slices,
        t1.clenbuterol,
        t1.watered,
        t1.`status`,
        t1.spot_check_time,
        t1.remark
        FROM
        meattrade_spot_check t1
        INNER JOIN meattrade_pork_report t2 on t1.pork_report_id = t2.id
        <where>
            t1.tenant = #{param.tenant}
            <if test="param.keyword != null and param.keyword != ''">
                and (t1.pork_report_code like concat('%',#{param.keyword},'%')
                <if test="param.supplierIds != null and param.supplierIds.size() > 0">
                    or t2.supplier_id in
                    <foreach collection="param.supplierIds" item="supplierId" open="(" separator="," close=")">
                        #{supplierId}
                    </foreach>
                </if>
                )
            </if>
            <if test="param.status != null">
                and t1.status = #{param.status}
            </if>
            <if test="param.clenbuterol != null">
                and t1.clenbuterol = #{param.clenbuterol}
            </if>
            <if test="param.watered != null">
                and t1.watered = #{param.watered}
            </if>
            <if test="param.ids != null and param.ids.size() > 0">
                and t1.id in
                <foreach collection="param.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="param.porkReportIds != null and param.porkReportIds.size() > 0">
                and t1.pork_report_id in
                <foreach collection="param.porkReportIds" item="porkReportId" open="(" separator="," close=")">
                    #{porkReportId}
                </foreach>
            </if>
            <if test="param.period != null and param.period.begin != null">
                and t1.create_time &gt;= #{param.period.begin}
            </if>
            <if test="param.period != null and param.period.end != null">
                and t1.create_time &lt;= #{param.period.end}
            </if>
            order by t1.pork_report_code desc
        </where>
    </select>

