java_library(
    name = "server",
    srcs = glob([
        "src/**/*.java",
        "src-dcm/**/*.java",
    ]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [":deps"],
)

_MAIN_CLASS = "com.guhecloud.cube.srv.gen.maintain.server.MaintainServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [
        ":server",
    ],
)

artifactId = "cube-srv-gen-maintain-server"

export(
    name = "package",
    artifact_id = artifactId,
    exclude_deps = [":deps"],
    package_group = PACKAGE_GROUP,
    release_version = VERSION,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

server_info(
    name = "server-info",
    database = "cube-srv-gen-maintain",
    datasource_package = "com.guhecloud.cube.srv.gen.maintain",
    gw_prefix = "/maintain/",
    main_class = _MAIN_CLASS,
    server = ":server",
    server_id = "maintain",
    visibility = ["//packages:__subpackages__"],
)
