<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.dao.InspectRecordToBusinessMapper">

    <select id="getRecordToBusinessByRecordIdList"
            resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.vo.InspectRecordToBusinessVO">
        select * from inspect_record_to_business
        <where>
            record_id in
            <foreach collection="recordIdList" item="recordId" open="(" separator="," close=")">
                #{recordId}
            </foreach>
        </where>
    </select>
</mapper>