<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.dao.InspectRecordItemMapper">
    <select id="listRecordErrorDesc" resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.po.InspectRecordItemPO">
        select record_id, error_desc
        from inspect_record_item iri
        <where>
            <if test="recordIdList != null and recordIdList.size > 0">
                <foreach collection="recordIdList" item="recordId" open="iri.record_id in (" separator="," close=")">
                    #{recordId}
                </foreach>
            </if>
            and error_desc &lt;&gt; ''
        </where>
    </select>

    <select id="listAbnormalRecordIdsByRecordIds" resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.po.InspectRecordItemPO">
        select record_id
        from inspect_record_item iri
        <where>
            iri.deleted = 0
            and iri.error_value_flag = 1
            <if test="recordIdList != null and recordIdList.size > 0">
                and iri.record_id in
                <foreach collection="recordIdList" item="recordId" open="(" separator="," close=")">
                    #{recordId}
                </foreach>
            </if>
        </where>
    </select>

    <select id="getListByRecordIdList"
            resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.vo.InspectRecordItemVO">
        select * from inspect_record_item where record_id in
        <foreach collection="recordIdList" item="recordId" open="(" separator="," close=")">
            #{recordId}
        </foreach>
        <if test="errorValueFlag != null">
            and error_value_flag = #{errorValueFlag}
        </if>
    </select>

    <select id="getRecordItemCollectData"
            resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.po.InspectRecordItemPO">
        select * from inspect_record_item
        <where>
            <if test="period != null and period.begin != null">
                update_time &gt;= #{period.begin}
            </if>
            <if test="period != null and period.end != null">
                and update_time &lt;= #{period.end}
            </if>
            <if test="true">
                and tenant = #{tenant} and error_value_flag = true and item_tag is not null
            </if>
        </where>
    </select>

    <select id="getInspectRecordItemsStatistics"
            resultType="com.guhecloud.cube.srv.gen.maintain.server.inspectionv2.model.dto.InspectRecordItemStatisticsVO">
        select
        `t1`.`item_id`,
        `t1`.`item_name`,
        count(`t1`.`id`) as `total_number`
        from `inspect_record_item` `t1`
        INNER JOIN `inspect_record` `t2` on `t1`.`record_id` = t2.`id`
        <where>
            <if test="param.itemErrorValueFlag != null">
                AND `t1`.`error_value_flag` = #{param.itemErrorValueFlag}
            </if>
            <if test="param.period != null and param.period.begin != null">
                and `t1`.`update_time` &gt;= #{param.period.begin}
            </if>
            <if test="param.period != null and param.period.end != null">
                and `t1`.`update_time` &lt;= #{param.period.end}
            </if>
        </where>
        group by `t1`.`item_id`,`t1`.`item_name`
    </select>
</mapper>
