<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.supplier.server.supplier.dao.GenSupplierMapper">
    <update id="updateDisable">
        <foreach collection="list" item="item" separator=";">
            UPDATE gen_supplier set  disable = #{item.disable} WHERE id = #{item.id}
        </foreach>
    </update>



</mapper>