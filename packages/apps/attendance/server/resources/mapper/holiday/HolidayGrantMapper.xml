<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.attendance.management.server.holiday.infrastructure.mapper.HolidayGrantMapper">

    <select id="selectExpiringListIgnoreTenant"
            resultType="com.guhecloud.cube.srv.gen.attendance.management.server.holiday.infrastructure.po.HolidayGrantPO"
    parameterType="collection">
        select * from `holiday_grant` where `remaining_balance`>0
        and (
        <foreach collection="cacheValues" item="cacheValue" separator="or">
        `holiday_type` = #{cacheValue.holidayType}
            <if test="cacheValue.expiryDate.expiryDateType.name() == 'CALENDAR_YEAR'">
                and TIMESTAMPDIFF(YEAR,NOW(),`create_time`) >= #{cacheValue.expiryDate.value}
            </if>
            <if test="cacheValue.expiryDate.expiryDateType.name() == 'FULL'">
                <if test="cacheValue.expiryDate.timeUnit.name() == 'YEAR'">

                </if>
                <if test="cacheValue.expiryDate.timeUnit.name() == 'MONTH'">
                    and ABS(TIMESTAMPDIFF(MONTH,`create_time`,NOW())) >= #{cacheValue.expiryDate.value}
                </if>
            </if>
        </foreach>
    )
    </select>
</mapper>