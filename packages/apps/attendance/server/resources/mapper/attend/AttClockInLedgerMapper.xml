<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.infrastructure.mapper.AttClockInLedgerMapper">
    <resultMap id="getClockInLedgerDetails"
               type="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedgerDetailsResult">
        <result column="iedger_id" property="iedgerId"></result>
        <result column="week" property="week"></result>
        <result column="today" property="today"></result>
        <collection property="details" javaType="java.util.ArrayList"
                    ofType="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedger">
            <result column="state" property="state"></result>
            <result column="start_work_time" property="startWorkTime"></result>
            <result column="end_work_time" property="endWorkTime"></result>
            <result column="start_work_state" property="startWorkState"></result>
            <result column="end_work_state" property="endWorkState"></result>
            <result column="start_work_details" property="startWorkDetails"></result>
            <result column="end_work_details" property="endWorkDetails"></result>
            <result column="clock_in_uuid" property="clockInUuid"></result>
            <result column="start_work_out" property="startWorkOut"></result>
            <result column="end_work_out" property="endWorkOut"></result>
            <result column="start_clock_in_time" property="startClockInTime"></result>
            <result column="end_clock_in_time" property="endClockInTime"></result>
            <result column="user_id" property="userId"></result>
            <result column="start_work_omit" property="startWorkOmit"></result>
            <result column="end_work_omit" property="endWorkOmit"></result>
        </collection>
    </resultMap>
    <select id="getClockInLedger"
            resultType="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedgerResult">
        select a.*
        from att_clock_in_ledger a
        <where>
            <if test="param.ledgerDate !=null and param.ledgerDate !=''">
                a.`ledger_date`=#{param.ledgerDate}
            </if>
            <if test="param.userId !=null">
                and a.`user_id` in
                <foreach collection="param.userId" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="param.orgId !=null and param.orgId !=''">
                and a.`org_id`=#{param.orgId}
            </if>
            <if test="param.userName !=null and param.userName !=''">
                and a.`user_name` like concat("%",#{param.userName},"%")
            </if>
        </where>
        order by a.`user_name`
    </select>
    <select id="getClockInLedgerList"
            resultType="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedgerResult">
        select a.*,c.name as attGroupName
        from att_clock_in_ledger a
        left join att_group_staff b on a.user_id=b.id
        left join att_group c on b.group_id=c.id
        <where>
            <if test="param.ledgerDate !=null and param.ledgerDate !=''">
                a.`ledger_date`=#{param.ledgerDate}
            </if>
            <if test="param.userId !=null">
                and a.`user_id` in
                <foreach collection="param.userId" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="param.orgId !=null and param.orgId !=''">
                and a.`org_id`=#{param.orgId}
            </if>
            <if test="param.groupId !=null and param.groupId !=''">
                and b.`group_id` =#{param.groupId}
            </if>
            <if test="param.userName !=null and param.userName !=''">
                and a.`user_name` like concat("%",#{param.userName},"%")
            </if>
        </where>
    </select>
    <select id="getClockInLedgerDetails"
            resultMap="getClockInLedgerDetails">
        select *
        from `att_clock_in_ledger_details`
        where `iedger_id` = #{id}
        order by `today`,`start_clock_in_time`
    </select>
    <select id="getClockInLogExcel"
            resultType="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedgerDetailsExcelResult">
        select a.`user_name`,a.`org_id`,a.`ledger_date`,
        b.`group_name` as `attGroupName`,
        d.`start_work_time`,
        d.`end_work_time`,
        d.`start_clock_in_time`,
        d.`end_clock_in_time`,
        d.`today`,
        d.`ledger_belong_date`
        from `att_clock_in_ledger` a
        inner join `att_clock_in_ledger_details` d on a.`id` = d.`iedger_id`
        left join `att_group_staff` b on a.`user_id` = b.`staff_id`
        where a.ledger_date = #{param.ledgerDate}
        <if test="param.userName !=null and param.userName != ''">
            and a.`user_name` like concat("%",#{param.userName},"%")
        </if>
        <if test="param.orgId !=null and param.orgId != ''">
            and a.`org_id` = #{param.orgId}
        </if>
        order by a.`user_name`,d.`today`
    </select>

    <select id="getLedgerDetailsExcel"
            resultType="com.guhecloud.cube.srv.gen.attendance.management.server.attend.clockin.interfaces.result.AttClockInLedgerDetailsExcelResult">
        select a.`user_name`,
        a.`org_id`,
        a.`ledger_date`,
        d.`state`,
        d.`start_clock_in_time`,
        d.`end_clock_in_time`,
        d.`start_work_time`,
        d.`end_work_time`,
        d.`today`,
        d.`start_work_state`,
        d.`end_work_state`,
        d.`classes_details`,
        d.`user_id`,
        d.`start_work_omit`,
        d.`end_work_omit`,
        d.`start_work_out`,
        d.`end_work_out`,
        d.`ledger_belong_date`
        from `att_clock_in_ledger` a
        inner join `att_clock_in_ledger_details` d on a.`id` = d.`iedger_id`
        where a.`ledger_date` = #{param.ledgerDate}
        <if test="ledgerBelongDate !=null and ledgerBelongDate !=''">
            and d.`ledger_belong_date` &lt;= #{ledgerBelongDate}
        </if>
        <if test="param.userName !=null and param.userName != ''">
            and a.`user_name` like concat("%",#{param.userName},"%")
        </if>
        <if test="param.orgId !=null and param.orgId != ''">
            and a.`org_id` = #{param.orgId}
        </if>
        order by a.`user_name`,d.`today`
    </select>
</mapper>