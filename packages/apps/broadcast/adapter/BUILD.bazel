load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_plugin", "java_test", "java_toolchain")
load("@rules_jvm_external//:defs.bzl", "artifact", "java_export", "maven_bom")
load("//packages/apps/broadcast/adapter:variables.bzl", "PACKAGE_GROUP", "VERSION")
load("//packages/deploy:variables.bzl", "VERSION_DEV", "VERSION_TEST")
load("//packages/deploy/tools:server_info.bzl", "server_info")
load("//tools/springboot:springboot.bzl", "springboot")

java_library(
    name = "server",
    srcs = glob(["src/**/*.java"]),
    resource_strip_prefix = package_name() + "/resources",
    resources = glob(["resources/**"]),
    deps = [
        "//packages/platform/base/standard:http",
        "//packages/platform/base/utils:date",
        "//packages/platform/base/utils:object",
        "//packages/platform/base/utils:string",
        "//packages/platform/base/utils:json",
        "//packages/platform/server",
        "//packages/platform/subsystem-requester-sdk",
        "//third-party/java/apache:hc5",
        "//third-party/java/apache:hc5-client",
        "//third-party/java/jackson",
    ],
)

_MAIN_CLASS = "com.guhecloud.cube.biz.adapter.broadcast.server.AdapterBroadcastServer"

java_binary(
    name = "server-bin",
    main_class = _MAIN_CLASS,
    runtime_deps = [":server"],
)

springboot(
    name = "server-exec",
    boot_app_class = _MAIN_CLASS,
    java_library = ":server",
)

artifactId = "subsystem-broadcast-server"

java_export(
    name = "export",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":server",
    ],
)

java_export(
    name = "export-dev",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION_DEV),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":server",
    ],
)

java_export(
    name = "export-test",
    maven_coordinates = "%s:%s:%s" % (PACKAGE_GROUP, artifactId, VERSION_TEST),
    tags = ["no-javadocs"],
    runtime_deps = [
        ":server",
    ],
)

server_info(
    name = "server-info",
    datasource_package = "com.guhecloud.cube.biz.adapter.broadcast",
    gw_prefix = "/broadcast-adapter/",
    main_class = _MAIN_CLASS,
    no_datasource = True,
    server = ":server",
    server_id = "adapterBroadcast",
    visibility = ["//packages:__subpackages__"],
)
