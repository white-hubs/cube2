<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guhecloud.cube.srv.gen.safety.management.monthlyreport.dao.MarketMonthlyReportMapper">

    <select id="selectMonthlyReportCount"
            resultType="com.guhecloud.cube.srv.gen.safety.management.monthlyreport.dto.vo.MonthlyMarketCountStatistics">
        SELECT
        t1.id,
        COUNT(t2.id) as totalNum
        FROM
        monthly_report t1
        INNER JOIN market_monthly_report t2 on t1.id = t2.monthly_report_id AND t2.deleted = 0
        <where>
            <if test="monthlyReportIds != null and monthlyReportIds.size > 0">
                and t1.id in
                <foreach collection="monthlyReportIds" item="reportId" open="(" separator="," close=")">
                    #{reportId}
                </foreach>
            </if>
        </where>
        GROUP BY t1.id
    </select>
</mapper>